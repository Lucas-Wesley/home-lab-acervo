#!/usr/bin/env bash
# yt-dlp falso para os testes. O id do vídeo decide o caso:
#   AAAAAAAAAAA português com legenda manual · EEEEEEEEEEE inglês só com legenda automática
#   SSSSSSSSSSS sem legenda · FFFFFFFFFFF vídeo indisponível
url="${!#}"
# Reel do Instagram (D40): LOGIN... pede login; os outros baixam um vídeo de 10 s com som e o info.json.
case "$url" in
  *instagram.com/reel/*)
    [ -n "$YTDLP_FALSO_ARGS" ] && printf '%s\n' "$*" >> "$YTDLP_FALSO_ARGS"
    id="${url%/}"; id="${id##*/}"
    case "$id" in LOGIN*) echo "ERROR: [Instagram] $id: Requested content is not available, rate-limit reached or login required. Use --cookies" >&2; exit 1 ;; esac
    out="" capa=0 sem_video=0
    while [ $# -gt 0 ]; do
      case "$1" in -o) out="$2" ;; --write-thumbnail) capa=1 ;; --skip-download) sem_video=1 ;; esac
      shift
    done
    base="${out%.%(ext)s}"
    # A capa do post (D46), em pé como a do Instagram: 640x1136, maior que a da lista.
    [ "$capa" = 1 ] && { ffmpeg -v error -f lavfi -i color=c=orange:size=640x1136 -frames:v 1 "$base.jpg" || exit 1; }
    [ "$sem_video" = 1 ] && exit 0
    ffmpeg -v error -f lavfi -i testsrc=duration=10:size=320x240:rate=10 -f lavfi -i sine=duration=10 -shortest -pix_fmt yuv420p "$base.mp4" || exit 1
    printf '{"id":"%s","title":"Video by conta","channel":"conta","uploader":"Conta de Teste","description":"Três dicas de estudo\\n\\nMais na legenda. #estudo","duration":10.0,"upload_date":"20260301","webpage_url":"%s"}\n' "$id" "$url" > "$base.info.json"
    exit 0 ;;
esac
# Busca de vídeos (Pesquisador): um curto demais, um com legenda e um sem legenda.
case "$url" in
  ytsearch*)
    printf '{"entries":[{"id":"CCCCCCCCCCC","title":"Curto","channel":"X","duration":30},{"id":"SSSSSSSSSSS","title":"Sem legenda","channel":"Y","duration":600},{"id":"AAAAAAAAAAA","title":"Vídeo bom","channel":"Canal","duration":900}]}\n'
    exit 0 ;;
esac
id="${url##*v=}"
json=0 out="" lang="" audio=0
while [ $# -gt 0 ]; do
  case "$1" in
    -J) json=1; shift ;;
    -o) out="$2"; shift 2 ;;
    --sub-langs) lang="$2"; shift 2 ;;
    -f) audio=1; shift 2 ;;
    *) shift ;;
  esac
done
if [ "$id" = FFFFFFFFFFF ]; then
  echo "ERROR: [youtube] $id: Video unavailable" >&2
  exit 1
fi
if [ $json = 1 ]; then
  case "$id" in
    AAAAAAAAAAA) idioma='"pt-BR"'; subs='{"pt-BR":[{}]}'; autos='{}' ;;
    EEEEEEEEEEE) idioma='"en"'; subs='{"live_chat":[{}]}'; autos='{"en-orig":[{}],"pt":[{}]}' ;;
    *) idioma=null; subs='{}'; autos='{}' ;;
  esac
  printf '{"id":"%s","title":"Vídeo %s","channel":"Canal","duration_string":"1:00","language":%s,"webpage_url":"%s","upload_date":"20260101","subtitles":%s,"automatic_captions":%s}\n' \
    "$id" "$id" "$idioma" "$url" "$subs" "$autos"
  exit 0
fi
# Só o áudio (D37: trecho de uma dúvida, ou o vídeo inteiro sem legenda): um tom de 40 s.
if [ $audio = 1 ]; then
  arquivo="${out/\%(ext)s/mp3}"
  ffmpeg -v error -f lavfi -i sine=duration=40 "$arquivo" 2>/dev/null || printf 'audio' > "$arquivo"
  exit 0
fi
cp "$(dirname "$0")/legenda.json3" "$out.$lang.json3"
