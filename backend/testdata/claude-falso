#!/usr/bin/env bash
# claude falso para os testes: faz o mínimo que cada regra pede, na pasta atual.
prompt=""
ferramentas=""
while [ $# -gt 0 ]; do
  case "$1" in
    -p) prompt="$2"; shift 2 ;;
    --allowedTools) ferramentas="$2"; shift 2 ;;
    --model) modelo="$2"; shift 2 ;;
    *) shift ;;
  esac
done
ok() { printf '{"type":"result","result":"%s","is_error":false}\n' "${1:-ok}"; }
pasta() { printf '%s' "$prompt" | sed -n 's/.*pasta \([^ ]*\)\/ (caminho.*/\1/p' | head -1; }
case "$prompt" in
  *"Escreva o resumo inteligente do Tema inteiro"*)
    arqs=$(find . -name '*.md' | sort | tr '\n' ' ')
    printf '{"type":"result","result":"","is_error":false,"structured_output":{"texto":"## Em uma frase\\n\\nResumo de teste. Arquivos: %s"}}\n' "$arqs" ;;
  *"Diga os conceitos anteriores"*)
    printf '{"type":"result","result":"","is_error":false,"structured_output":{"conceitos":[{"nome":"Conceito base","tipo":"base","por_que":"Ajuda.","explicacao":"Explicação base (ferramentas: %s).","tema":"temas/outro","fontes":[{"titulo":"Fonte","url":"https://exemplo.com"}]},{"nome":"Vizinho","tipo":"vizinho","por_que":"Contexto.","explicacao":"Explicação vizinha.","tema":"temas/nao-existe","fontes":[]}]}}\n' "$ferramentas" ;;
  *"Monte o banco de perguntas do simulado"*)
    itens=""
    for n in 1 2 3 4 5 6; do itens="$itens{\"pergunta\":\"Pergunta $n?\",\"esperada\":\"Resposta $n.\",\"capitulo\":\"Fundação\",\"nivel\":\"entender\"},"; done
    printf '{"type":"result","result":"","is_error":false,"structured_output":{"perguntas":[%s]}}\n' "${itens%,}" ;;
  *"Corrija o simulado em simulado.md"*)
    n=$(grep -c '^## Pergunta ' simulado.md)
    voz=""; grep -q '(falada' simulado.md && voz=" Teve resposta falada."
    [ -f tema/indice.md ] || voz="$voz Sem o Tema."
    itens='{"n":1,"avaliacao":"certa","comentario":"Isso.","faltou":""}'
    for i in $(seq 2 "$n"); do itens="$itens,{\"n\":$i,\"avaliacao\":\"errada\",\"comentario\":\"Não.\",\"faltou\":\"Faltou $i.\"}"; done
    printf '{"type":"result","result":"","is_error":false,"structured_output":{"nota":%d,"comentario":"Corrigido.%s","itens":[%s],"revisar":["Fundação"]}}\n' $((100 / n)) "$voz" "$itens" ;;
  *"escreva tela.md nesta pasta"*)
    { for q in quadros/*.jpg; do n=$(basename "$q" .jpg); printf '[%s] Texto na tela: "quadro %s".\n\n' "${n/-/:}" "$n"; done
      grep -q 'Três dicas de estudo' contexto.md && printf 'Leu o contexto.\n'; } > tela.md
    ok ;;
  *"Monte o esboço da pesquisa"*)
    [ -n "$CLAUDE_FALSO_FALHA" ] && { printf '{"result":"limite de uso atingido","is_error":true}\n'; exit 1; }
    printf '{"type":"result","result":"","is_error":false,"structured_output":{"titulo":"A origem da laranja","perguntas":[{"pergunta":"De onde vem a laranja?","livros":"laranja Ásia","wikipedia":"Laranja (fruta)","youtube":"origem da laranja"},{"pergunta":"Como chegou ao Brasil?","livros":"","wikipedia":"Citricultura no Brasil","youtube":"laranja no Brasil"},{"pergunta":"   ","livros":"x","wikipedia":"x","youtube":"x"}],"relacionados":["temas/laranja","temas/nao-existe"]}}\n' ;;
  *"Escreva organizado.md nesta pasta"*)
    {
      printf '# Pesquisa de teste\n\n> Texto de teste escrito a partir do material.\n\n## Seção\n\nConteúdo da pesquisa [1].\n\n<sub>Fontes: [1]</sub>\n\n'
      case "$prompt" in *"não escolheu nenhuma fonte"*) printf '*Sem fontes: escrito com o conhecimento da IA, sem pesquisa.*\n\n' ;; esac
      printf 'Ferramentas: %s.\n\nMaterial lido:\n' "$ferramentas"
      ls fontes 2>/dev/null | sed 's/^/- /'
      [ -f anterior.md ] && printf '\nPartiu de anterior.md.\n'
      ls ja-escrito 2>/dev/null | sed 's/^/- já escrito: /'
      case "$prompt" in *"O que ele quer a mais"*) printf '\nFoco recebido.\n' ;; esac
      printf '\n## Dúvidas\n\n- Uma dúvida de teste.\n'
    } > organizado.md
    case "$ferramentas" in *WebSearch*) printf '# Página\n\nURL: https://exemplo.com\n' > fontes/web-1.md ;; esac
    ok ;;
  *"Leia o texto inteiro e escreva organizado.md"*)
    {
      printf '# Resumo de teste\n\n> Resumo dos capítulos escolhidos.\n\n## Ideia central\n\nO que o autor defende.\n\n'
      grep -o '\[p\. [0-9]*\]([^)]*)' cru.md | head -2 | tr '\n' ' ' | sed 's/^/<sub>Páginas: /; s/ $/<\/sub>/'
      printf '\n'
      case "$prompt" in *"O que interessa ao Lucas"*) printf '\nFoco recebido.\n' ;; esac
      case "$prompt" in *"marcacoes.md"*) [ -f marcacoes.md ] && printf '\nMarcações recebidas.\n' ;; esac
    } > organizado.md
    ok ;;
  *"Confira organizado.md contra o material"*)
    [ -n "$CLAUDE_FALSO_CONFERIR_FALHA" ] && { printf '# x\n' > organizado.md; printf '{"result":"limite de uso atingido","is_error":true}\n'; exit 1; }
    printf -- '- Conferência: 1 afirmação corrigida e 0 saíram do texto.\n' >> organizado.md; ok ;;
  *"escreva organizado.md"*)
    [ -n "$CLAUDE_FALSO_FALHA" ] && { printf '{"result":"limite de uso atingido","is_error":true}\n'; exit 1; }
    extra=""; case "$prompt" in *"REGRA EDITADA"*) extra="Seguiu a regra editada no app." ;; esac
    printf '# Organizado\n\n> Texto de teste organizado, com conteúdo suficiente.\n\n## Seção\n\nConteúdo. %s\n' "$extra" > organizado.md; ok ;;
  *"escreva traducao.md"*)
    printf '# Traduzido\n\nTexto de teste traduzido para o português, com conteúdo suficiente.\n' > traducao.md; ok ;;
  *"Os Temas do Acervo"*)
    printf '{"type":"result","result":"","is_error":false,"structured_output":{"acao":"novo","tema":"","titulo":"Tema de Teste","motivo":"Nenhum Tema parecido.","outros":[]}}\n' ;;
  *"decidiu criar o Tema"*)
    p=$(pasta); mkdir -p "$p"
    printf -- '---\ntitulo: Tema de Teste\ncriado: 2026-01-01\nreferencias:\n  - id: r1\n    titulo: Vídeo\n    url: https://www.youtube.com/watch?v=AAAAAAAAAAA\n---\n\n# Tema de Teste\n\nIntrodução do Tema.\n\n## Primeiro capítulo\n\nTexto do primeiro capítulo.\n\n<sub>Fonte: r1 [00:30]</sub>\n\n## Segundo capítulo\n\nTexto do segundo capítulo.\n\n## Linha do tempo\n\n- **1494** — Tordesilhas.\n' > "$p/indice.md"
    [ -n "$CLAUDE_FALSO_FORA" ] && echo intruso > README.md
    ok ;;
  *"integrá-la ao Tema"*)
    [ -n "$CLAUDE_FALSO_NADA" ] && { ok "nada novo"; exit 0; }
    printf '\nParágrafo integrado.\n' >> "$(pasta)/indice.md"; ok ;;
  *"pediu para integrar ao texto"*)
    [ -n "$CLAUDE_FALSO_NADA" ] && { ok "nada novo"; exit 0; }
    m=$(printf '%s' "$prompt" | sed -n 's/^O que integrar está em \([^ ]*material\.md\)\..*/\1/p')
    escolhas=$(grep -o '^[0-9]*\. \*\*[^*]*\*\*' "$m" | sed 's/.*\*\*\(.*\)\*\*/\1/' | tr '\n' ',' | sed 's/,$//')
    modo=$(grep -o 'Modo escolhido pelo Lucas: \*\*[^*]*\*\*' "$m" | sed 's/.*\*\*\(.*\)\*\*/\1/')
    linha="Integrado ao texto (escolhas: ${escolhas}; modo: ${modo})."
    if [ -n "$(pasta)" ]; then printf '\n%s\n' "$linha" >> "$(pasta)/indice.md"; else printf '\n%s\n' "$linha" >> texto.md; fi
    # Uma dúvida resolvida corrige o trecho no corpo do texto.
    if grep -q 'uma dúvida resolvida' "$m" && [ -f texto.md ]; then
      sed 's/^Texto organizado\.$/Texto corrigido pelo áudio./' texto.md > texto.tmp && mv texto.tmp texto.md
    fi
    ok ;;
  *"Marque os capítulos"*)
    tema=""; case "$prompt" in *"temas/clube"*) tema='"temas/clube"' ;; esac
    itens=""
    for n in $(grep -o '^## Capítulo [0-9]*' capitulos.md | awk '{print $3}'); do
      itens="$itens{\"n\":$n,\"resumo\":\"Capítulo $n (modelo: $modelo).\",\"temas\":[$tema],\"pessoas\":[\"Pessoa $n\"],\"organizacoes\":[],\"lugares\":[\"Lugar $n\"],\"periodos\":[],\"eventos\":[],\"trechos\":[]},"
    done
    printf '{"type":"result","result":"","is_error":false,"structured_output":{"capitulos":[%s]}}\n' "${itens%,}" ;;
  *"Resolva as dúvidas de duvidas.md"*)
    n=$(grep -c '^## Dúvida ' duvidas.md)
    itens=""
    for i in $(seq 0 $((n-1))); do
      bloco=$(awk -v i="$i" '/^## Dúvida /{d=($3==i)} d' duvidas.md)
      if printf '%s' "$bloco" | grep -q 'Whisper large-v3 ouviu'; then estado=resolvida_audio; ouvido=$(printf '%s\n' "$bloco" | awk '/ouviu/{o=1;next} o && /^\[/{print;exit}'); else estado=lacuna; ouvido=""; fi
      trecho=""; correto=""
      [ "$i" = 0 ] && { trecho="Texto organizado."; correto="Texto corrigido pelo áudio."; }
      ouvido=$(printf '%s' "$ouvido" | tr -d '"\\')
      itens="$itens{\"indice\":$i,\"estado\":\"$estado\",\"no_audio\":\"$ouvido\",\"explicacao\":\"Apurado $i.\",\"trecho\":\"$trecho\",\"correto\":\"$correto\",\"fontes\":[]},"
    done
    printf '{"type":"result","result":"","is_error":false,"structured_output":{"duvidas":[%s]}}\n' "${itens%,}" ;;
  *"A mensagem do Lucas:"*)
    lidos=$(ls texto | tr '\n' ' ' | sed 's/ $//')
    extra=""
    case "$prompt" in *"A conversa até aqui"*"PRIMEIRA MENSAGEM"*) extra="$extra Lembrou da conversa." ;; esac
    case "$prompt" in *"<trecho>"*"Fundado em 1930"*"</trecho>"*) extra="$extra Recebeu o trecho." ;; esac
    [ -f acervo.md ] && grep -q "temas/clube" acervo.md && extra="$extra Recebeu o mapa do Acervo."
    arq=indice.md; [ -f texto/texto.md ] && arq=texto.md
    antes="Fundado em 1930."; depois="Fundado em 1930, no Recife."
    if ! grep -qF "$antes" "texto/$arq"; then antes=$(grep -m1 '^# ' "texto/$arq" | tr -d '"\\'); depois="$antes (revisto)"; fi
    printf '{"type":"result","result":"","is_error":false,"structured_output":{"resposta":"Resposta de teste. Leu: %s. Ferramentas: %s.%s","pesquisou":true,"fontes":[{"titulo":"Fonte A","url":"https://exemplo.com/a"}],"no_acervo":[{"titulo":"Clube","caminho":"temas/clube"},{"titulo":"Inventado","caminho":"temas/nao-existe"}],"alteracoes":[{"arquivo":"%s","antes":"%s","depois":"%s","resumo":"Cidade da fundação"},{"arquivo":"%s","antes":"Trecho que não existe.","depois":"x","resumo":"Cai"}]}}\n' "$lidos" "$ferramentas" "$extra" "$arq" "$antes" "$depois" "$arq" ;;
  *"e perguntou:"*)
    [ -n "$CLAUDE_FALSO_FALHA" ] && { printf '{"result":"limite de uso atingido","is_error":true}\n'; exit 1; }
    lidos=$(ls | tr '\n' ' ' | sed 's/ $//')
    printf '{"type":"result","result":"","is_error":false,"structured_output":{"cobertura":"em_parte","no_texto":"O texto diz 1930 (capítulo Fundação).","resposta":"Fundado em 1930 [1]. Leu: %s. Ferramentas: %s.%s","selo":"confirmado","divergencias":[{"tipo":"omissao","capitulo":"Fundação","no_texto":"","correto":"A data exata é 25 de janeiro.","selo":"confirmado","fontes":[1,2]}],"fontes":[{"titulo":"Fonte A","url":"https://exemplo.com/a"},{"titulo":"Fonte B","url":"https://exemplo.org/b"}]}}\n' "$lidos" "$ferramentas" "$(case "$prompt" in *"Livros da biblioteca do Lucas"*) printf ' Com livros da biblioteca.' ;; esac)" ;;
  *"selecionou um trecho"*)
    [ -n "$CLAUDE_FALSO_FALHA" ] && { printf '{"result":"limite de uso atingido","is_error":true}\n'; exit 1; }
    sleep "${CLAUDE_FALSO_ESPERA:-0}"
    printf '{"type":"result","result":"","is_error":false,"structured_output":{"explicacao":"**Explicação de teste.** Ferramentas: %s.","fontes":[{"titulo":"Fonte A","url":"https://exemplo.com/a"},{"titulo":"Fonte B","url":"https://exemplo.org/b"}]}}\n' "$ferramentas" ;;
  *)
    printf '{"result":"pedido desconhecido","is_error":true}\n'; exit 1 ;;
esac
